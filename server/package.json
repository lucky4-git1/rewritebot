    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@google/generative-ai": "^0.2.0",
    "@prisma/client": "^5.8.0",
    "@rewritebot/shared": "*",
    "argon2": "^0.31.2",
    "axios": "^1.6.5",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "fastify": "^4.25.2",
    "ioredis": "^5.3.2",
    "nanoid": "^5.0.4",
    "openai": "^4.24.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
