# Database
DATABASE_URL=postgresql://rewritebot:password@localhost:5432/rewritebot

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Credential Encryption
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=your-32-byte-base64-encoded-encryption-key

# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
MAX_INPUT_CHARACTERS=50000

# Feature Flags
GRAMMAR_ENABLED=true
SUMMARIZER_ENABLED=true
TRANSLATOR_ENABLED=true
CITATIONS_ENABLED=true
AI_DETECTOR_ENABLED=true
PLAGIARISM_ENABLED=false

# Logging
LOG_LEVEL=info
